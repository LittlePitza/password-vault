{
  "name": "password-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestor de contraseñas local para Chrome/Edge. La bóveda nunca sale del dispositivo.",
  "scripts": {
    "dev": "wxt -b edge",
    "dev:chrome": "wxt",
    "build": "wxt build -b edge",
    "build:chrome": "wxt build",
    "zip": "wxt zip -b edge",
    "zip:chrome": "wxt zip",
    "icons": "node scripts/generate-icons.mjs",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run compile && npm run lint && npm run test",
    "postinstall": "wxt prepare",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@noble/hashes": "^2.2.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@wxt-dev/module-react": "^1.1.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wxt": "^0.21.3"
  }
}
